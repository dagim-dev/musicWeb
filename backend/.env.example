# Comma-separated frontend origins allowed by CORS (include production + local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Ephemeral job storage (Railway container disk)
TEMP_DIR=/tmp/tunefetch/jobs

# Required on Railway: base64-encoded Netscape cookies.txt from a logged-in YouTube session.
# Export locally: yt-dlp --cookies-from-browser chrome --cookies cookies.txt --skip-download "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
# Then: base64 -i cookies.txt | tr -d '\n'  (paste result into Railway as YOUTUBE_COOKIES_BASE64)
YOUTUBE_COOKIES_BASE64=
